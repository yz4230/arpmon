{{ define "content" }}
<div class="container py-4">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
      <a class="link-secondary text-decoration-none" href="/">&larr; Back to dashboard</a>
      <h1 class="h3 mt-2 mb-0">Scan runs</h1>
    </div>
    <div class="d-flex align-items-center gap-2">
      <a class="btn btn-primary" href="/scan-runs/new">New scan run</a>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      {{ if .ScanRuns }}
      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
          <thead>
            <tr>
              <th scope="col">ID</th>
              <th scope="col">Target</th>
              <th scope="col">Created</th>
            </tr>
          </thead>
          <tbody>
            {{ range .ScanRuns }}
            <tr>
              <th scope="row">{{ .ID }}</th>
              <td><a class="link-body-emphasis" href="/scan-runs/{{ .ID }}" aria-label="View scan run {{ .ID }}"><code>{{ .TargetNetwork.String }}</code></a></td>
              <td>{{ formatDateTime .CreatedAt }}</td>
            </tr>
            {{ end }}
          </tbody>
        </table>
      </div>
      {{ else }}
      <div class="text-center py-5">
        <p class="text-body-secondary mb-3">No scan runs found.</p>
        <a class="btn btn-primary" href="/scan-runs/new">Run your first scan</a>
      </div>
      {{ end }}
    </div>
  </div>
</div>
{{ end }}
