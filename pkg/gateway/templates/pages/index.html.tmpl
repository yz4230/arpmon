{{ define "content" }}
<div class="container py-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">Probes</h1>
    <span class="badge text-bg-secondary">{{ len .Probes }}</span>
  </div>

  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th scope="col">ID</th>
          <th scope="col">Target</th>
          <th scope="col">Created</th>
          <th scope="col">Updated</th>
        </tr>
      </thead>
      <tbody>
        {{ range .Probes }}
        <tr>
          <th scope="row">{{ .ID }}</th>
          <td><code>{{ .Target.String }}</code></td>
          <td>{{ formatDateTime .CreatedAt }}</td>
          <td>{{ formatDateTime .UpdatedAt }}</td>
        </tr>
        {{ else }}
        <tr>
          <td colspan="4" class="text-center text-body-secondary py-4">No probes found.</td>
        </tr>
        {{ end }}
      </tbody>
    </table>
  </div>
</div>
{{ end }}
