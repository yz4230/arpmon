{{ define "content" }}
<div class="container py-4">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
      <p class="text-uppercase text-body-secondary small fw-semibold mb-1">ARP Monitor</p>
      <h1 class="h3 mb-1">Dashboard</h1>
      <p class="text-body-secondary mb-0">Keep an eye on your network probing activity.</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
      <a class="btn btn-outline-secondary" href="/members">Members</a>
      <a class="btn btn-outline-secondary" href="/probes">Probes</a>
      <a class="btn btn-primary" href="/probes/new">New probe</a>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-md-4">
      <div class="card h-100 shadow-sm">
        <div class="card-body">
          <p class="text-body-secondary mb-2">Members</p>
          <p class="display-5 fw-semibold mb-0" data-stat="member-count">{{ .Stats.MemberCount }}</p>
          <a class="small" href="/members">Manage members &rarr;</a>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 shadow-sm">
        <div class="card-body">
          <p class="text-body-secondary mb-2">Probes (last 7 days)</p>
          <p class="display-5 fw-semibold mb-0" data-stat="recent-probe-count">{{ .Stats.RecentProbeCount }}</p>
          <span class="small text-body-secondary">Based on probe creation time</span>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 shadow-sm">
        <div class="card-body">
          <p class="text-body-secondary mb-2">Total probes</p>
          <p class="display-5 fw-semibold mb-0" data-stat="total-probe-count">{{ .Stats.TotalProbeCount }}</p>
          <a class="small" href="/probes">View probe history &rarr;</a>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-sm mt-4">
    <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
      <div>
        <h2 class="h5 mb-1">Ready to scan?</h2>
        <p class="text-body-secondary mb-0">Run a probe and record the current member attendance.</p>
      </div>
      <a class="btn btn-primary" href="/probes/new">Run a new probe</a>
    </div>
  </div>
</div>
{{ end }}
