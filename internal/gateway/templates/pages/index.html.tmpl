{{ define "content" }}
<div class="container py-4">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
      <p class="text-uppercase text-body-secondary small fw-semibold mb-1">ARP Monitor</p>
      <h1 class="h3 mb-1">Dashboard</h1>
      <p class="text-body-secondary mb-0">Keep an eye on your network probing activity.</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
      <a class="btn btn-outline-secondary" href="/members">Members</a>
      <a class="btn btn-outline-secondary" href="/scan-runs">Scan runs</a>
      <a class="btn btn-primary" href="/scan-runs/new">New scan</a>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-md-4">
      <div class="card h-100 shadow-sm">
        <div class="card-body">
          <p class="text-body-secondary mb-2">Uptime</p>
          <p class="display-5 fw-semibold mb-0" data-stat="uptime">{{ .Stats.Uptime }}</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 shadow-sm">
        <div class="card-body">
          <p class="text-body-secondary mb-2">Total scan runs</p>
          <p class="display-5 fw-semibold mb-0" data-stat="total-scan-run-count">{{ .Stats.TotalScanRunCount }}</p>
          <a class="small" href="/scan-runs">View scan history &rarr;</a>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 shadow-sm">
        <div class="card-body">
          <p class="text-body-secondary mb-2">Members</p>
          <p class="display-5 fw-semibold mb-0" data-stat="member-count">{{ .Stats.MemberCount }}</p>
          <a class="small" href="/members">Manage members &rarr;</a>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-sm mt-4">
    <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
      <div>
        <h2 class="h5 mb-1">Ready to scan?</h2>
        <p class="text-body-secondary mb-0">Run a network scan and record the current member attendance.</p>
      </div>
      <a class="btn btn-primary" href="/scan-runs/new">Run a new scan</a>
    </div>
  </div>
</div>
{{ end }}
